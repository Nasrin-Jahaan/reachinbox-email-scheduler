NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

ELASTICSEARCH_NODE=http://localhost:9200

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

SLACK_CLIENT_ID=REPLACE_WITH_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=REPLACE_WITH_SLACK_CLIENT_SECRET
SLACK_SIGNING_SECRET=REPLACE_WITH_SLACK_SIGNING_SECRET
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

ETHEREAL_USER=
ETHEREAL_PASSWORD=

WORKER_CONCURRENCY=5

MIN_DELAY_BETWEEN_EMAILS_MS=2000

MAX_EMAILS_PER_HOUR_PER_SENDER=200

FRONTEND_URL=http://localhost:5173

COOKIE_SECURE=false
